---
// Shows src/assets/headshot.(jpg|jpeg|png|webp) if present, otherwise initials.
import { Image } from 'astro:assets';
import { site } from '../config';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const found = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../assets/headshot.{jpg,jpeg,png,webp}', { eager: true }),
)[0];
const initials = site.name.split(' ').map((p) => p[0]).join('');
// Never upscale: use the photo's own width (a larger original gives a sharper result).
const width = found ? Math.min(found.default.width, 480) : 0;
---
{found ? (
  <Image
    src={found.default}
    alt={`Portrait of ${site.name}`}
    width={width}
    class:list={['h-auto w-full rounded-2xl border border-line object-cover shadow-sm', cls]}
    loading="eager"
    fetchpriority="high"
  />
) : (
  <div
    class:list={['flex aspect-square items-center justify-center rounded-2xl bg-accent-soft font-serif text-6xl font-semibold text-accent', cls]}
    role="img"
    aria-label={`${site.name} (photo coming soon)`}
  >{initials}</div>
)}
