---
import { site } from '../config';
const year = new Date().getFullYear();
const updated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---
<footer class="mt-20 border-t-4 border-accent bg-footer-bg text-footer-fg">
  <div class="container-page flex flex-col gap-2 py-8 text-sm md:flex-row md:items-start md:justify-between md:gap-8">
    <p>© {year} {site.name} · {site.institution} · Updated {updated}</p>
    <p class="md:max-w-md md:text-right">{site.aiAttribution}. {site.aiRole}</p>
  </div>
</footer>
