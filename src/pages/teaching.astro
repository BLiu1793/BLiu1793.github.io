---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getCollection } from 'astro:content';

const courses = (await getCollection('teaching')).sort((a, b) => a.data.order - b.data.order);
const institutions = [...new Set(courses.map((c) => c.data.institution))];
---
<BaseLayout title="Teaching" description="Courses taught by Dr. Bo Liu at Washington State University Tri-Cities and Kansas State University.">
  <PageHeader title="Teaching" lead="Undergraduate and graduate courses in power systems and renewable energy." />
  <div class="container-page py-10">
    {institutions.map((inst) => (
      <section class="mb-12" aria-labelledby={inst.replace(/\W+/g, '-')}>
        <h2 id={inst.replace(/\W+/g, '-')} class="section-title">{inst}</h2>
        <ul class="grid gap-4 md:grid-cols-2">
          {courses.filter((c) => c.data.institution === inst).map((c) => (
            <li class="card">
              <p class="text-sm font-semibold tracking-wide text-accent">{c.data.code}</p>
              <h3 class="mt-1 text-lg font-semibold">{c.data.title}</h3>
              {c.data.description && <p class="mt-2 text-sm">{c.data.description}</p>}
              <p class="mt-3 text-sm text-muted">{c.data.role} · {c.data.terms.join(', ')}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
