---
import BaseLayout from '../layouts/BaseLayout.astro';
import { nav } from '../config';
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <div class="container-page py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">404</p>
    <h1 class="mt-2 text-4xl font-semibold">Page not found</h1>
    <p class="mt-4 text-muted">The page may have moved. Try one of these:</p>
    <ul class="mt-6 flex flex-wrap justify-center gap-3">
      {nav.map((n) => <li><a class="btn" href={n.href}>{n.label}</a></li>)}
    </ul>
  </div>
</BaseLayout>
