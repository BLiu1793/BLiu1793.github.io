---
// Research page: funded projects and awards only.
// Data: src/content/projects/*.md (one file per project) and src/content/awards.yaml
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { render } from 'astro:content';
import { site } from '../config';
import { visible } from '../lib/content';

const projects = (await visible('projects')).sort((a, b) => a.data.order - b.data.order);
const withBodies = await Promise.all(projects.map(async (p) => ({ p, Body: (await render(p)).Content })));
const groups = [
  { heading: 'Current', items: withBodies.filter(({ p }) => p.data.status === 'current') },
  { heading: 'Previous (Kansas State University)', items: withBodies.filter(({ p }) => p.data.status === 'previous') },
].filter((g) => g.items.length > 0);
const money = (n?: number) =>
  site.features.showFundingAmounts && n ? ` · $${n.toLocaleString('en-US')}` : '';

const awards = await visible('awards');
---
<BaseLayout title="Research" description={`Funded research projects and awards of ${site.name}, ${site.institution}.`}>
  <PageHeader title="Research" />

  <div class="container-page py-12">
    <section id="funding" class="mb-14 scroll-mt-24" aria-labelledby="funding-h">
      <h2 id="funding-h" class="section-title">Funded projects</h2>
      {groups.map((g) => (
        <>
          <h3 class="mb-3 font-sans text-sm font-semibold uppercase tracking-wide text-muted">{g.heading}</h3>
          <ul class="mb-8 grid gap-4 md:grid-cols-2">
            {g.items.map(({ p, Body }) => (
              <li class="card">
                <p class="font-semibold">{p.data.link ? <a href={p.data.link}>{p.data.title}</a> : p.data.title}</p>
                <p class="mt-1 text-sm text-muted">{p.data.role} · {p.data.sponsor} · {p.data.period}{money(p.data.amount)}</p>
                <div class="prose-lite mt-2 text-sm"><Body /></div>
              </li>
            ))}
          </ul>
        </>
      ))}
    </section>

    <section id="awards" class="scroll-mt-24" aria-labelledby="awards-h">
      <h2 id="awards-h" class="section-title">Awards</h2>
      <ul class="space-y-2">
        {awards.map((a) => (
          <li><span class="font-medium">{a.data.title}</span>, {a.data.organization} ({a.data.years})</li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
